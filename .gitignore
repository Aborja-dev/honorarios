# Dependencias y salida de compilación
node_modules/
dist/
.angular/
out-tsc/
coverage/
*.tsbuildinfo

# Gestor de paquetes: este proyecto usa Yarn (yarn.lock). Un package-lock.json indica un `npm install` por error.
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno y secretos: nunca se versionan
.env
.env.*
*.pem
*.key

# Editor y sistema
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db
*.suo
*.sw?
*.local

# README.md: temporal, mientras se revisa; aún no se sube al repositorio.
# Para publicarlo: borrar esta línea (y si ya se agregó con `git add`, usar `git add -f README.md`).
README.md
*.md
bitacora.md